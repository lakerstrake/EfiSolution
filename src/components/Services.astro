---
import ServiceCard from './ServiceCard.astro';
import { getSiteContent, type Locale } from '../i18n/siteContent';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getSiteContent(locale).services;
---

<section id="servicios" class="cv-auto section-padding" aria-labelledby="services-title">
  <div class="container-x">
    <div class="reveal flex flex-col items-start gap-5 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        <span class="eyebrow">
          <span class="eyebrow-dot"></span>
          {t.badge}
        </span>
        <h2 id="services-title" class="mt-5 font-display text-fluid-4xl font-semibold leading-[1.06] tracking-tightest text-zinc-900 dark:text-white">
          {t.title}
        </h2>
      </div>
      <p class="max-w-sm text-fluid-base leading-relaxed text-zinc-600 dark:text-zinc-400">
        {t.description}
      </p>
    </div>

    <ul class="mt-10 grid list-none gap-5 sm:grid-cols-2 lg:grid-cols-4" aria-label={t.listLabel}>
      {t.services.map((service, index) => (
        <li class="flex">
          <ServiceCard
            index={index}
            number={service.number}
            title={service.title}
            description={service.description}
            bullets={service.bullets}
            iconPath={service.iconPath}
          />
        </li>
      ))}
    </ul>

    <ol class="reveal mt-14 grid border-t-2 border-zinc-900 dark:border-zinc-200/60 sm:grid-cols-2 lg:grid-cols-4" aria-label={t.processLabel}>
      {t.steps.map((step) => (
        <li class="border-b border-zinc-300/70 py-6 dark:border-white/10 sm:px-5 sm:odd:pl-0 lg:border-b-0 lg:border-r lg:px-6 lg:first:pl-0 lg:last:border-r-0">
          <div class="flex items-baseline justify-between gap-3">
            <p class="font-mono text-xs font-semibold text-accent-700 dark:text-accent-400">{step.k}</p>
            <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-zinc-500">{step.d}</p>
          </div>
          <p class="mt-3 font-display text-xl font-semibold text-zinc-900 dark:text-zinc-100">{step.v}</p>
          <p class="mt-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{step.desc}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
