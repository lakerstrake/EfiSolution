---
import CTAButton from './CTAButton.astro';
import { getSiteContent, type Locale } from '../i18n/siteContent';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = getSiteContent(locale);
const t = content.hero;

// Prueba real arriba del pliegue: primera frase del testimonio verificado.
const review = content.testimonials.items[0];
const excerpt = review ? review.quote.split(/(?<=\.)\s/)[0] : '';
---

<section id="inicio" class="relative overflow-hidden pb-12 pt-24 md:pb-16 md:pt-32" aria-labelledby="hero-title">
  <div class="container-x">
    <div class="grid gap-12 lg:grid-cols-12 lg:items-end lg:gap-10">
      <div class="lg:col-span-8">
        <div class="hero-enter hero-enter-delay-1">
          <span class="eyebrow">
            <span class="eyebrow-dot"></span>
            {t.badge}
          </span>
        </div>

        <h1
          id="hero-title"
          class="mt-6 font-display text-fluid-5xl font-medium leading-[1.02] tracking-tightest text-zinc-900 md:text-fluid-6xl dark:text-zinc-50"
        >
          {t.titleA}
          <br />
          <span class="accent-text">{t.titleB}</span>
        </h1>

        {/* Sin animación: en móvil este párrafo puede ser el elemento LCP. */}
        <p class="mt-7 max-w-xl text-fluid-lg leading-relaxed text-zinc-600 dark:text-zinc-400">
          {t.description}
        </p>

        <div class="hero-enter hero-enter-delay-4 mt-9 flex w-full flex-col items-stretch gap-3 sm:flex-row sm:items-center">
          <CTAButton href="#planes" variant="primary" size="lg" ariaLabel={t.ctaPrimary} dataTrack="cta" dataLabel="hero">
            {t.ctaPrimary}
          </CTAButton>
          <CTAButton href="#contacto" variant="ghost" size="lg" icon={false}>
            {t.ctaGhost}
          </CTAButton>
        </div>
      </div>

      {review && (
        <aside class="hero-enter hero-enter-delay-4 lg:col-span-4">
          <figure class="relative rounded-2xl border border-zinc-900 bg-zinc-50 p-6 pt-7 shadow-hard dark:border-zinc-200/40 dark:bg-zinc-900 dark:shadow-hard-accent">
            <span class="absolute -top-3 left-5 rounded bg-accent-600 px-2 py-1 font-mono text-[10px] font-semibold uppercase tracking-[0.16em] text-white">
              {content.testimonials.verifiedLabel}
            </span>
            <span aria-hidden="true" class="block font-display text-5xl leading-[0.6] text-accent-600">&ldquo;</span>
            <blockquote class="mt-3 font-display text-fluid-xl italic leading-snug text-zinc-900 dark:text-zinc-100">
              {excerpt}
            </blockquote>
            <figcaption class="mt-5 flex items-center gap-3 border-t border-dashed border-zinc-300 pt-4 dark:border-white/15">
              {review.logo && (
                <img
                  src={review.logo.replace(/\.png$/, '.webp')}
                  alt=""
                  width="40"
                  height="40"
                  decoding="async"
                  class="h-10 w-10 rounded-full border border-zinc-200 bg-white object-contain dark:border-white/10"
                />
              )}
              <span class="min-w-0">
                <span class="block text-sm font-semibold text-zinc-900 dark:text-zinc-100">{review.name}</span>
                <span class="block truncate text-xs text-zinc-500">{review.role}</span>
              </span>
            </figcaption>
            <a
              href="#cliente"
              class="mt-4 inline-flex items-center gap-1.5 font-mono text-[11px] font-semibold uppercase tracking-[0.14em] text-accent-600 underline-offset-4 hover:underline dark:text-accent-400"
            >
              {content.clientCase.fullCase} <span aria-hidden="true">→</span>
            </a>
          </figure>
        </aside>
      )}
    </div>

    <dl class="reveal mt-14 grid grid-cols-2 border-y border-zinc-900/80 md:grid-cols-4 dark:border-zinc-200/30">
      {t.metrics.map((metric, i) => (
        <div class={`px-1 py-5 sm:px-5 ${i % 2 === 1 ? 'border-l' : ''} ${i >= 2 ? 'border-t md:border-t-0' : ''} ${i === 2 ? 'md:border-l' : ''} border-zinc-900/15 dark:border-white/10`}>
          <dt class="min-h-[2.8em] font-mono text-[10px] uppercase leading-snug tracking-[0.16em] text-zinc-500 sm:min-h-0 sm:text-[11px]">{metric.label}</dt>
          <dd class="mt-2 font-display text-fluid-3xl font-medium text-zinc-900 dark:text-zinc-50">{metric.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
