---
interface Props {
  href?: string;
  variant?: 'primary' | 'ghost';
  size?: 'md' | 'lg';
  ariaLabel?: string;
  icon?: boolean;
  target?: string;
  rel?: string;
  dataTrack?: string;
  dataLabel?: string;
}

const {
  href = '#contacto',
  variant = 'primary',
  size = 'lg',
  ariaLabel,
  icon = true,
  target,
  rel,
  dataTrack,
  dataLabel,
} = Astro.props;

const base =
  'group relative inline-flex max-w-full items-center justify-center gap-2.5 rounded-lg text-center font-semibold tracking-tight transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-400 focus-visible:ring-offset-2 focus-visible:ring-offset-zinc-50 dark:focus-visible:ring-offset-zinc-950 hover:-translate-x-0.5 hover:-translate-y-0.5 active:translate-x-0 active:translate-y-0';

// Padding y tipografía reducidos en móvil: el texto más largo (FR/PT) debe
// caber en un viewport de 320px sin desbordar. Área táctil ≥44px de alto.
const sizes: Record<string, string> = {
  md: 'min-h-11 px-5 py-2.5 text-sm',
  lg: 'min-h-11 px-5 py-3 text-sm sm:px-7 sm:py-3.5 sm:text-base',
};

// Tinta sólida + sombra dura de brasa al pasar el cursor (firma visual).
const variants: Record<string, string> = {
  primary:
    'bg-zinc-900 text-zinc-50 hover:shadow-hard-accent active:shadow-none dark:bg-zinc-50 dark:text-zinc-900',
  ghost:
    'border border-zinc-900/80 text-zinc-900 hover:bg-zinc-900 hover:text-zinc-50 dark:border-zinc-200/50 dark:text-zinc-100 dark:hover:bg-zinc-50 dark:hover:text-zinc-900',
};
---

<a
  href={href}
  aria-label={ariaLabel}
  target={target}
  rel={rel}
  data-track={dataTrack}
  data-label={dataLabel}
  class={`${base} ${sizes[size]} ${variants[variant]}`}
>
  <span class="relative z-10"><slot /></span>
  {icon && (
    <span
      aria-hidden="true"
      class="relative z-10 inline-flex transition-transform duration-300 group-hover:translate-x-1"
    >
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M5 12h14" />
        <path d="M12 5l7 7-7 7" />
      </svg>
    </span>
  )}
</a>
