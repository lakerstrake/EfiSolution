---
import { getSiteContent, type Locale } from '../i18n/siteContent';
import { whatsappHref } from '../lib/whatsapp';
import { caseRoute } from '../lib/altRoutes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = getSiteContent(locale);
const t = content.clientCase;
// El testimonio vive aquí (antes también tenía sección propia y se repetía 3 veces).
const testimonial = content.testimonials.items[0];
const waHref = whatsappHref(t.waMessage);
const siteUrl = 'https://buhorepuestos.com';
---

<section id="cliente" class="cv-auto section-padding" aria-labelledby="client-case-title">
  <div class="container-x">
    <div class="reveal grid gap-6 border-b border-zinc-900 pb-8 dark:border-zinc-200/40 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-8">
        <span class="eyebrow">
          <span class="eyebrow-dot"></span>
          {t.badge}
        </span>
        <h2 id="client-case-title" class="mt-6 font-display text-fluid-4xl font-semibold leading-[1.06] tracking-tightest text-zinc-900 dark:text-white">
          {t.title}
        </h2>
      </div>
      <div class="flex items-center gap-3 lg:col-span-4 lg:justify-end">
        <span class="flex h-12 w-12 flex-none items-center justify-center overflow-hidden rounded-full border border-zinc-300 bg-white dark:border-white/10">
          <picture>
            <source srcset="/buho-logo.webp" type="image/webp" />
            <img src={testimonial.logo} alt="" width="48" height="48" loading="lazy" decoding="async" class="h-full w-full object-cover" />
          </picture>
        </span>
        <div class="min-w-0">
          <p class="font-display text-lg font-semibold leading-tight text-zinc-900 dark:text-white">{t.name}</p>
          <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-zinc-500">{t.sector}</p>
        </div>
      </div>
    </div>

    <div class="mt-10 grid gap-10 lg:grid-cols-12 lg:gap-14">
      <!-- Columna izquierda: la historia del cliente -->
      <div class="reveal min-w-0 lg:col-span-7">
        <dl class="divide-y divide-zinc-300/70 dark:divide-white/10">
          <div class="grid gap-2 pb-6 sm:grid-cols-[10rem_1fr] sm:gap-6">
            <dt class="font-mono text-[11px] font-semibold uppercase tracking-[0.16em] text-zinc-500 sm:pt-1">{t.problemLabel}</dt>
            <dd class="text-fluid-base leading-relaxed text-zinc-800 dark:text-zinc-200">{t.problem}</dd>
          </div>
          <div class="grid gap-2 py-6 sm:grid-cols-[10rem_1fr] sm:gap-6">
            <dt class="font-mono text-[11px] font-semibold uppercase tracking-[0.16em] text-zinc-500 sm:pt-1">{t.builtLabel}</dt>
            <dd>
              <ul class="grid gap-2 sm:grid-cols-2">
                {t.built.map((item) => (
                  <li class="flex items-start gap-2.5 text-[15px] text-zinc-700 dark:text-zinc-300">
                    <span aria-hidden="true" class="mt-[0.6em] h-px w-3 flex-none bg-accent-600"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </dd>
          </div>
          <div class="grid gap-2 pt-6 sm:grid-cols-[10rem_1fr] sm:gap-6">
            <dt class="font-mono text-[11px] font-semibold uppercase tracking-[0.16em] text-zinc-500 sm:pt-1">{t.resultsLabel}</dt>
            <dd>
              <ul class="space-y-2">
                {t.results.map((item) => (
                  <li class="flex items-start gap-2.5 text-[15px] font-medium text-zinc-900 dark:text-zinc-100">
                    <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" class="mt-1 flex-none text-accent-600 dark:text-accent-400"><path d="M20 6 9 17l-5-5" /></svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        </dl>

        <figure class="mt-10 border-l-2 border-accent-600 pl-6">
          <blockquote class="font-display text-fluid-xl italic leading-snug text-zinc-900 dark:text-zinc-100">
            “{testimonial.quote}”
          </blockquote>
          <figcaption class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
            <span class="font-semibold text-zinc-900 dark:text-white">{testimonial.name}</span>
            <span class="text-zinc-500">{testimonial.role}</span>
            <span class="font-mono text-[10px] font-semibold uppercase tracking-[0.14em] text-accent-700 dark:text-accent-400">· {content.testimonials.verifiedLabel}</span>
          </figcaption>
        </figure>

        <div class="mt-9 flex flex-wrap items-center gap-3">
          <a href={siteUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-lg bg-zinc-900 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-accent-600 dark:bg-white dark:text-zinc-900 dark:hover:bg-zinc-200">
            {t.visit}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" /><polyline points="15 3 21 3 21 9" /><line x1="10" y1="14" x2="21" y2="3" /></svg>
          </a>
          {waHref && (
            <a href={waHref} target="_blank" rel="noopener noreferrer" data-track="whatsapp" data-label="caso" class="inline-flex items-center gap-2 rounded-lg border border-zinc-900 px-5 py-2.5 text-sm font-semibold text-zinc-900 transition-colors hover:bg-zinc-900 hover:text-white dark:border-zinc-200/60 dark:text-zinc-100 dark:hover:bg-white dark:hover:text-zinc-900">
              {t.cta}
            </a>
          )}
          <a href={caseRoute[locale]} data-track="case" data-label="home-caso" class="inline-flex items-center gap-2 px-3 py-2.5 text-sm font-semibold text-accent-700 underline-offset-4 transition-colors hover:underline dark:text-accent-400">
            {t.fullCase}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="M12 5l7 7-7 7" /></svg>
          </a>
        </div>
      </div>

      <!-- Columna derecha: vista real del sitio del cliente -->
      <aside class="reveal min-w-0 lg:col-span-5">
        <a href={siteUrl} target="_blank" rel="noopener noreferrer" aria-label={`${t.visit}: ${t.name}`} class="block overflow-hidden rounded-xl border border-zinc-900 bg-zinc-100 shadow-hard transition-transform duration-300 hover:-translate-x-0.5 hover:-translate-y-0.5 dark:border-zinc-200/40 dark:bg-zinc-900 dark:shadow-hard-accent lg:sticky lg:top-28">
          <div class="flex items-center gap-2 border-b border-zinc-900 px-3 py-2 dark:border-zinc-200/40">
            <span class="h-2 w-2 rounded-full bg-zinc-400"></span>
            <span class="h-2 w-2 rounded-full bg-zinc-400"></span>
            <span class="h-2 w-2 rounded-full bg-zinc-400"></span>
            <span class="ml-2 truncate font-mono text-[10px] text-zinc-500">buhorepuestos.com</span>
            <span class="ml-auto flex-none rounded bg-accent-600 px-1.5 py-0.5 font-mono text-[9px] font-semibold uppercase tracking-[0.12em] text-white">{t.realLabel}</span>
          </div>
          <div class="aspect-[16/10] w-full overflow-hidden">
            <picture>
              <source srcset="/buho.avif" type="image/avif" />
              <source srcset="/buho.webp" type="image/webp" />
              <img src="/buho.png" alt={t.name} width="800" height="500" loading="lazy" decoding="async" class="h-full w-full object-cover object-top" />
            </picture>
          </div>
        </a>
      </aside>
    </div>
  </div>
</section>
