---
import { getSiteContent, type Locale } from '../i18n/siteContent';
import { whatsappHref } from '../lib/whatsapp';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getSiteContent(locale).problem;
const waHref = whatsappHref(t.waMessage);
---

<section id="problema" class="cv-auto section-padding" aria-labelledby="problem-title">
  <div class="container-x">
    <div class="reveal max-w-4xl">
      <span class="eyebrow">
        <span class="eyebrow-dot"></span>
        {t.badge}
      </span>

      <h2 id="problem-title" class="mt-6 font-display text-fluid-4xl font-semibold leading-[1.06] tracking-tightest text-zinc-900 dark:text-white">
        {t.titleA} <span class="accent-text">{t.titleB}</span>
      </h2>

      <p class="mt-5 max-w-xl text-fluid-base leading-relaxed text-zinc-600 dark:text-zinc-400">
        {t.description}
      </p>

      {waHref && (
        <a
          href={waHref}
          target="_blank"
          rel="noopener noreferrer"
          data-track="whatsapp"
          data-label="diagnostico"
          class="mt-7 inline-flex items-center gap-2 rounded-lg bg-zinc-900 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-accent-600 dark:bg-white dark:text-zinc-900 dark:hover:bg-zinc-200"
        >
          {t.cta}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="M12 5l7 7-7 7" /></svg>
        </a>
      )}
    </div>

    <div class="mt-12 grid gap-10 lg:grid-cols-12 lg:gap-14">
      <div class="reveal grid grid-cols-2 gap-6 self-start lg:col-span-4 lg:grid-cols-1">
        <div class="border-t-2 border-zinc-900 pt-4 dark:border-zinc-200/60">
          <p class="font-display text-[clamp(2.5rem,1.8rem+3vw,4rem)] font-medium leading-none tracking-tightest text-zinc-900 dark:text-white">
            53<span class="text-accent-600 dark:text-accent-400">%</span>
          </p>
          <p class="mt-3 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{t.statA}</p>
        </div>
        <div class="border-t-2 border-zinc-900 pt-4 dark:border-zinc-200/60">
          <p class="font-display text-[clamp(2.5rem,1.8rem+3vw,4rem)] font-medium leading-none tracking-tightest text-zinc-900 dark:text-white">
            7<span class="text-accent-600 dark:text-accent-400">%</span>
          </p>
          <p class="mt-3 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{t.statB}</p>
        </div>
      </div>

      <ol class="min-w-0 divide-y divide-zinc-300/70 border-y border-zinc-300/70 dark:divide-white/10 dark:border-white/10 lg:col-span-8" aria-label={t.sequenceLabel}>
        {t.blocks.map((block, index) => (
          <li
            class="reveal grid gap-3 py-7 sm:grid-cols-[4.5rem_1fr] sm:gap-6"
            style={`transition-delay: ${index * 100}ms`}
          >
            <span class="font-mono text-sm font-semibold text-accent-700 dark:text-accent-400">
              0{index + 1}
              <span class="mt-1 block text-[10px] uppercase tracking-[0.16em] text-zinc-500">{block.tag}</span>
            </span>
            <div>
              <h3 class="font-display text-fluid-2xl font-semibold leading-tight text-zinc-900 dark:text-white">{block.headline}</h3>
              <p class="mt-2 text-fluid-base leading-relaxed text-zinc-600 dark:text-zinc-400">{block.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
